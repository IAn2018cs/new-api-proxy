# Target domain to proxy requests to
TARGET_DOMAIN=https://api.openai.com

# Port to listen on
PORT=3000

# API key to replace/inject in request headers
# When set, the proxy will replace Authorization, x-api-key, api-key headers with this value
# If no auth header is present in the request, Authorization: Bearer <API_KEY> will be added
API_KEY=sk-your-api-key-here

# TCP/TLS connection timeout; 0 disables it
CONNECT_TIMEOUT_MS=10000

# Timeout only when an active upstream connection has no I/O; 0 disables it
# Streaming responses can last indefinitely while data continues to arrive
UPSTREAM_IDLE_TIMEOUT_MS=300000

# Timeout for unused pooled upstream connections, not active requests
KEEP_ALIVE_TIMEOUT_MS=4000

# Drain active requests on SIGTERM/SIGINT, then close remaining connections
# Keep Docker's stop_grace_period longer than this value
SHUTDOWN_TIMEOUT_MS=10000

# Daily access logs are retained for 90 calendar days in Asia/Shanghai.
# Docker Compose mounts ./logs into /app/logs automatically.
# For direct node execution, optionally set LOG_DIR to another local directory.
